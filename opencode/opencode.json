{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": []
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@tarquinen/opencode-dcp@2.1.8"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm *": "ask",
      "mv *": "ask",
      "cp -r*": "ask",
      "npm install*": "ask",
      "npm uninstall*": "ask",
      "yarn install*": "ask",
      "yarn add*": "ask",
      "yarn remove*": "ask",
      "pnpm install*": "ask",
      "pnpm add*": "ask",
      "pnpm remove*": "ask",
      "aws *": "ask",
      "gcloud *": "ask",
      "az *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "systemctl *": "ask",
      "service *": "ask"
    },
    "webfetch": "ask",
    "lsp": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "Figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "remote",
      "oauth": {
        "clientId": "Qcbs5uor89FXC4SG5S7fdH",
        "clientSecret": "ESVbDHjdBgp00Pw9OBOvguVXwS6sOA"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      ".next/**",
      ".turbo/**",
      "coverage/**",
      "**/*.min.js",
      "**/*.map",
      ".cache/**",
      "tmp/**",
      "temp/**",
      ".opencode/**",
      "**/.DS_Store",
      "**/thumbs.db",
      "**/*.swp",
      "**/*.swo",
      "**/*~",
      ".vscode/**",
      ".idea/**",
      "*.lock",
      "yarn.lock",
      "package-lock.json",
      "pnpm-lock.yaml"
    ]
  }
}
