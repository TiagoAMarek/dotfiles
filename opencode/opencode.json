{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "share": "disabled",
  "autoupdate": false,
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    },
    "diff_style": "auto"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": []
  },
  "keybinds": {
    "session_child_cycle": "ctrl+alt+right",
    "session_child_cycle_reverse": "ctrl+alt+left"
  },
  "plugin": ["@franlol/opencode-md-table-formatter@0.0.3"],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "rg *": "allow"
    },
    "webfetch": "ask",
    "lsp": "allow"
  },
  "agent": {
    "commit": {
      "description": "Compose commit messages following the Commitizen convention",
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini",
      "prompt": "You are a meticulous commit message authoring agent specializing in the Commitizen convention. Your task is to generate concise, clear, and convention-compliant commit messages for code changes.",
      "tools": {
        "bash": true
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-4.5",
      "prompt": "You are an expert next.js 14 + Typescript code reviewer. Focus on security, performance, and maintainability.",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      ".next/**",
      ".turbo/**",
      "coverage/**"
    ]
  }
}
